        MapOps[병렬 처리]
    end
    
    subgraph Integration["외부 통합"]
        GitHub[GitHub CLI]
        GoogleDrive[Google Drive]
        MCP[MCP 서버]
    end
    
    subgraph MCPServers["MCP 서비스"]
